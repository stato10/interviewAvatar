# ============================================================================
# Avatar Coach — the only file you need to edit.
# Run `python scripts/setup.py` first: it creates .env from this file,
# generates AGENT_API_KEY, and tells you exactly what is still missing.
# ============================================================================

# --- Required ---------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LiveKit Cloud → your project → Settings → Keys  (wss://<project>.livekit.cloud)
# Using `docker compose -f compose.yaml -f compose.livekit.yaml up`? Leave these empty:
# the local LiveKit server is configured automatically.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Shared secret between backend and agent. Generated by scripts/setup.py.
AGENT_API_KEY=

# --- Coach behaviour (optional) --------------------------------------------
# realtime = one speech-to-speech model (fastest, hears tone of voice)
# pipeline = separate transcription -> text model -> speech (cheaper)
COACH_MODE=realtime
COACH_LANGUAGE=he
# Model IDs are picked automatically from what your OpenAI key can use.
# Set any of these only to force a specific model:
# COACH_REALTIME_MODEL=gpt-realtime-2.1
# COACH_TRANSCRIBE_MODEL=gpt-live-transcribe
# COACH_REPORT_MODEL=gpt-5.4-mini
# COACH_REALTIME_VOICE=marin

# Attach camera frames so the coach can comment on body language (costs more tokens).
ENABLE_VISION=true
# BVC noise cancellation works only on LiveKit Cloud. Set false for self-hosted LiveKit.
ENABLE_NOISE_CANCELLATION=true

# --- Avatar (optional) -----------------------------------------------------
# Beyond Presence video avatar. Leave empty for a voice-only coach.
BEY_API_KEY=
BEY_AVATAR_ID=

# --- Deployment (optional) -------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host:5432/interview_avatar
# CORS_ORIGINS=https://your-frontend.example.com
