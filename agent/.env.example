OPENAI_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

BACKEND_URL=http://localhost:8000
# Must match backend AGENT_API_KEY
AGENT_API_KEY=

# Optional model / voice overrides
# COACH_LLM_MODEL=gpt-4o
# COACH_REPORT_MODEL=gpt-4o-mini
# COACH_STT_MODEL=gpt-4o-transcribe
# COACH_TTS_MODEL=gpt-4o-mini-tts
# COACH_TTS_VOICE=shimmer
# COACH_LANGUAGE=he

# Set to false when not using LiveKit Cloud (BVC noise cancellation is Cloud-only)
# ENABLE_NOISE_CANCELLATION=true
# Attach camera frames to user turns (multimodal)
# ENABLE_VISION=true

# Optional Beyond Presence avatar (voice-only when unset)
# BEY_API_KEY=
# BEY_AVATAR_ID=
