# LiveKit (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional — defaults to SQLite in backend/interview_avatar.db
# DATABASE_URL=postgresql://user:pass@host:5432/interview_avatar

# Browser origins allowed to call the API (comma-separated, or *)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared secret: the agent must send it to POST reports. Set the same value in agent/.env.local.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
